{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bifaria",
  "version": "1.0.3",
  "identifier": "com.bifaria.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Bifaria",
        "width": 340,
        "height": 100,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "focus": false,
        "focusable": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bifaria",
    "copyright": "Copyright (c) 2026 Eugene Otsevich. MIT License.",
    "category": "Productivity",
    "shortDescription": "Local-first voice dictation and translation",
    "longDescription": "Bifaria records your speech, transcribes it locally, optionally translates it with AI, and pastes the result into the active window.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": { "depends": ["libvulkan1"] },
      "rpm": { "depends": ["vulkan-loader"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQzIxOTNGNTQ2RDk5NkEKUldScW1XMVVQeG5DK2tIK0lLZm5xb3VralMvZmUrSHVzOHhxMFdxeW93VEk2c2NSTTNKYzF5MHkK",
      "endpoints": [
        "https://github.com/eotsevych/bifaria/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
